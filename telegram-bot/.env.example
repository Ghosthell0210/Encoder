# ═══════════════════════════════════════════════════════════════════
# 1. Credenciales obligatorias de Telegram (MTProto hasta 2 GB)
#    • API_ID y API_HASH → https://my.telegram.org (API development tools)
#    • BOT_TOKEN         → @BotFather (/newbot)
#    • OWNER_ID          → @userinfobot (tu ID numérico)
# ═══════════════════════════════════════════════════════════════════
API_ID=12345678
API_HASH=tu_api_hash_aqui
BOT_TOKEN=123456789:tu_bot_token_aqui
OWNER_ID=123456789

# ═══════════════════════════════════════════════════════════════════
# 2. Cuenta de Telegram opcional (puedes dejarlo vacío y usar /login
#    directamente en Telegram, o ejecutar: python3 login_account.py)
#    • Con Telegram Premium habilita subidas nativas hasta 4 GB.
#    • DUMP_CHAT_ID: ID de canal privado donde estén tu cuenta y el bot
#      como admins para entregar videos de 2–4 GB a cualquier usuario.
# ═══════════════════════════════════════════════════════════════════
USER_SESSION_STRING=
DUMP_CHAT_ID=

# ═══════════════════════════════════════════════════════════════════
# 3. Recursos asignados en panel.plugged.host (auto-detecta cgroups)
#    Con AUTO_DETECT_RESOURCES=true lee CPU y RAM directo del contenedor;
#    MAX_CPU_THREADS y MAX_RAM_GB actúan como respaldo o manual si es false.
# ═══════════════════════════════════════════════════════════════════
AUTO_DETECT_RESOURCES=true
MAX_CPU_THREADS=5
MAX_RAM_GB=4
MAX_DISK_GB=30
DISK_RESERVE_GB=2.0
MAX_CONCURRENT_JOBS=1
# Conexiones MTProto en paralelo (2–12) para descargas/subidas rápidas (20–60+ MB/s)
FAST_TRANSFER_WORKERS=8

# Modo de acceso inicial: private (solo dueño + lista blanca) | public
ACCESS_MODE=private

# ═══════════════════════════════════════════════════════════════════
# 4. Entrega automática por enlace si el video comprimido supera 2 GB
#    (o >4 GB si tienes cuenta Premium conectada)
#    Proveedor preferido: gofile | buzzheavier | direct_http
# ═══════════════════════════════════════════════════════════════════
LARGE_FILE_UPLOADER=gofile
GOFILE_TOKEN=

# Opcional: solo si quieres servir enlaces directos temporales desde
# tu propio puerto de panel.plugged.host (sin web UI, solo /dl/<token>)
PUBLIC_DOWNLOAD_BASE_URL=
DIRECT_LINK_HOST=0.0.0.0
DIRECT_LINK_PORT=8080
DIRECT_LINK_TTL_HOURS=6

# Intervalo mínimo en segundos para actualizar la barra de progreso
PROGRESS_INTERVAL_SEC=3.5

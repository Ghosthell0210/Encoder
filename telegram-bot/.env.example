# ═══════════════════════════════════════════════════════════════════
# Credenciales obligatorias de Telegram (MTProto hasta 2 GB)
# Obtén API_ID y API_HASH en: https://my.telegram.org
# Obtén BOT_TOKEN en: @BotFather
# Obtén tu OWNER_ID numérico en: @userinfobot
# ═══════════════════════════════════════════════════════════════════
API_ID=12345678
API_HASH=tu_api_hash_aqui
BOT_TOKEN=123456789:tu_bot_token_aqui
OWNER_ID=123456789

# ═══════════════════════════════════════════════════════════════════
# Recursos asignados en panel.plugged.host (Máxima potencia libre)
# ═══════════════════════════════════════════════════════════════════
MAX_CPU_THREADS=4
MAX_RAM_GB=10
MAX_DISK_GB=30
DISK_RESERVE_GB=2.0
MAX_CONCURRENT_JOBS=1

# Modo de acceso inicial: private (solo dueño + lista blanca) | public
ACCESS_MODE=private

# ═══════════════════════════════════════════════════════════════════
# Entrega automática por enlace si el video comprimido supera 2 GB
# Proveedor preferido: gofile | buzzheavier | direct_http
# (GoFile funciona sin clave; si fallara, cambia automáticamente)
# ═══════════════════════════════════════════════════════════════════
LARGE_FILE_UPLOADER=gofile
GOFILE_TOKEN=

# Opcional: solo si quieres servir enlaces directos temporales desde
# tu propio puerto de panel.plugged.host (sin web UI, solo /dl/<token>)
PUBLIC_DOWNLOAD_BASE_URL=
DIRECT_LINK_HOST=0.0.0.0
DIRECT_LINK_PORT=8080
DIRECT_LINK_TTL_HOURS=6

# Intervalo mínimo en segundos para actualizar la barra de progreso
PROGRESS_INTERVAL_SEC=3.5
